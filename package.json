{
  "name": "tarun-tej-portfolio",
  "version": "1.1.0",
  "private": true,
  "description": "Personal portfolio with an original interactive 3D sculpture and coding project case studies.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "check": "node --check dist/app.js && node --check dist/scene.js && node --check dist/ui-state.js && node scripts/check.mjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test": "node --test scripts/*.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "resources:stage": "node scripts/build-app-release.mjs",
    "predev": "npm run resources:stage",
    "precheck": "npm run resources:stage",
    "build": "npm run resources:stage && npm run check",
    "test:resources:ui": "node --test scripts/resource-*.test.mjs",
    "resources:refresh": "node scripts/resources/resource-server.mjs refresh --config resources/sources.json --output resources/catalog.json",
    "resources:serve": "node scripts/resources/resource-server.mjs serve --config resources/sources.json --snapshot resources/catalog.json",
    "test:resources": "node --test scripts/resources/resource-catalog.test.mjs && node scripts/resources/check-catalog.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
